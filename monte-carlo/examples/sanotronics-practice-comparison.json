{
  "type": "monte-carlo-studio",
  "schemaVersion": 1,
  "model": {
    "name": "Sanotronics \u2014 practice: lower demand or less uncertainty",
    "description": "Predict first: How will lower demand (Case A) or less uncertainty (Case B) change mean profit, variability and loss probability? Costs and uniform draws are identical in all scenarios. Baseline demand mean 15000, SD 4500. Case A mean 12000, SD 4500. Case B mean 15000, SD 2250. Run and compare after recording your predictions. BUS-3150 Lecture 33 practice; seed 20261106; 1000 trials.",
    "inputs": [
      {
        "id": "price",
        "label": "Selling price ($/unit)",
        "type": "constant",
        "value": 249
      },
      {
        "id": "fixedCost",
        "label": "Fixed cost ($)",
        "type": "constant",
        "value": 1000000
      },
      {
        "id": "labor",
        "label": "Labor cost ($/unit)",
        "type": "discrete",
        "values": [
          {
            "value": 43,
            "probability": 0.1
          },
          {
            "value": 44,
            "probability": 0.2
          },
          {
            "value": 45,
            "probability": 0.4
          },
          {
            "value": 46,
            "probability": 0.2
          },
          {
            "value": 47,
            "probability": 0.1
          }
        ]
      },
      {
        "id": "parts",
        "label": "Parts cost ($/unit)",
        "type": "uniform",
        "min": 80,
        "max": 100
      },
      {
        "id": "demand",
        "label": "Demand (units)",
        "type": "normal",
        "mean": 15000,
        "sd": 4500
      }
    ],
    "outputs": [
      {
        "id": "contribution",
        "label": "Unit contribution ($/unit)",
        "formula": "price - labor - parts"
      },
      {
        "id": "profit",
        "label": "Profit ($)",
        "formula": "contribution * demand - fixedCost"
      }
    ],
    "settings": {
      "trials": 1000,
      "seed": 20261106,
      "riskOutput": "profit",
      "lossThreshold": 0,
      "target": 1000000
    },
    "traceUniforms": [
      0.9109,
      0.4576,
      0.6026
    ]
  },
